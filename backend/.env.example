# development | test | production
NODE_ENV=development
PORT=8080
# Origen del frontend (o varios separados por comas). CORS y la protección CSRF usan esta lista.
# Usar el mismo host que la API (devices.localhost): con SameSite=Lax la cookie no viaja
# entre hosts distintos (p. ej. 127.0.0.1 y localhost).
CORS_ORIGIN=http://devices.localhost:3000
# Atributo Secure de la cookie de sesión. Sin valor: false en development, true en el resto.
COOKIE_SECURE=false

# MySQL de docker-compose.yml
MYSQL_ROOT_PASSWORD=MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=device_management
MYSQL_USER=MYSQL_USER
MYSQL_PASSWORD=MYSQL_PASSWORD
MYSQL_PORT=3306
DATABASE_URL=mysql://MYSQL_USER:MYSQL_PASSWORD@127.0.0.1:3306/MYSQL_DATABASE
