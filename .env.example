# local y dev usan mocks; production y staging usan HTTP.
# Sin esta variable: next dev usa dev, next build/start usa production.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Solo aplica a mocks. Dejar el valor vacío para usar la fecha real del navegador.
NEXT_PUBLIC_MOCK_TODAY=2026-10-07
NEXT_PUBLIC_MOCK_SCENARIO=default
NEXT_PUBLIC_MOCK_DELAY_MS=350
